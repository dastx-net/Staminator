# Preserve original bytes and line endings in the legacy source tree.
src/stamina/** -text
src/stamina_setup/** -text

# New project documentation uses UTF-8 and normalized line endings.
*.md text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
*.rs text eol=lf
*.toml text eol=lf
Cargo.lock text eol=lf

# Automation scripts run on Linux.
*.sh text eol=lf
*.py text eol=lf
*.json text eol=lf
Jenkinsfile text eol=lf
Dockerfile text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.xml text eol=lf
